# Copy to .env and fill in. `.env` is gitignored.

# Required — TabPFN via the Prior Labs API. Create at https://platform.priorlabs.ai (promo code TABPFN4AIDEV)
TABPFN_TOKEN=

# Required for the notebooks — Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Optional — Jev, the decision model used as the router in notebook 04. Key from https://console.typesafe.ai
# Leave empty and the agent routes with Claude instead.
TYPESAFE_API_KEY=

# Optional — which Claude model the notebooks use
CLAUDE_MODEL=claude-sonnet-5-5
